# JVM unit tests run on the plain JVM, where the Android variants GRADLE_VARIANTS redirects -jvm
# artifacts to can't work (e.g. DataStore's calls android.os.Build). Gradle gives JVM modules the
# -jvm variant; here //third_party/jvm_test_variants puts these jars, fetched without their
# dependencies, first on every unit test's runtime classpath. Generated by bazel/scripts/repin.py.
JVM_TEST_VARIANTS = [
    "androidx.compose.runtime:runtime-annotation-jvm:1.13.0",
    "androidx.datastore:datastore-core-jvm:1.3.0",
    "androidx.datastore:datastore-preferences-core-jvm:1.3.0",
    "androidx.window:window-core-jvm:1.5.0",
    "com.squareup.okhttp3:okhttp-jvm:5.5.1",
]

[
    maven.artifact(
        name = "maven_jvm_test_variants",
        testonly = True,
        artifact = coords.split(":")[1],
        exclusions = ["*:*"],
        group = coords.split(":")[0],
        version = coords.split(":")[2],
    )
    for coords in JVM_TEST_VARIANTS
]

maven.install(
    name = "maven_jvm_test_variants",
    fail_if_repin_required = True,
    lock_file = "//:maven_jvm_test_variants_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    resolver = "maven",
)
use_repo(maven, "maven_jvm_test_variants")

# The AutoMobile JUnit runner, for //app's AutoMobile device tests. A repository of its own: the
# tests don't touch the app's code, and the runner's dependencies (Koog, JUnit 5) stay out of the
# APK's resolution and the Gradle alignment above. The version must match auto-mobile-junit-runner
# in gradle/libs.versions.toml and the auto-mobile CLI the CI job installs. Repin with
#   REPIN=1 bazel run @maven_automobile//:pin
maven.install(
    name = "maven_automobile",
    artifacts = ["dev.jasonpearson.auto-mobile:auto-mobile-junit-runner:0.0.67"],
    # rules_kotlin's toolchain puts its own (newer) standard library on the classpath.
    excluded_artifacts = ["org.jetbrains.kotlin:kotlin-stdlib"],
    fail_if_repin_required = True,
    lock_file = "//:maven_automobile_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
    resolver = "maven",
)
use_repo(maven, "maven_automobile")

# rules_android's desugarer reads class files with ASM 9.7, which stops at Java 24. Point it at
# ASM 9.11 so the project can emit Java 25 bytecode.
[
    maven.override(
        name = "rules_android_maven",
        coordinates = "org.ow2.asm:" + artifact,
        target = "@maven//:org_ow2_asm_" + artifact.replace("-", "_"),
    )
    for artifact in [
        "asm",
        "asm-analysis",
        "asm-commons",
        "asm-tree",
        "asm-util",
    ]
]
