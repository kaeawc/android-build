"""Bazel build for android-build.

Bazel is the primary build (CLI and CI). The Gradle build is kept only so Android Studio can
sync the project. Library versions here mirror gradle/libs.versions.toml; bump both together.
"""

module(name = "android_build")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# Not used directly: named so .bazelrc can switch the build's protoc to the prebuilt release
# binary (--@protobuf//bazel/toolchains:prefer_prebuilt_protoc) instead of compiling it, and
# abseil, from C++ sources. The version is the one rules_java / rules_kotlin already resolve.
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_kotlin", version = "2.4.21")

bazel_dep(name = "buildifier_prebuilt", version = "10.2.0", dev_dependency = True)

# Kotlin incremental compilation through the Build Tools API isn't in a tagged rules_kotlin
# release yet. Until it is, build rules_kotlin from the incremental compilation stack
# (bazel-contrib/rules_kotlin PRs via 0xLucasMarcal/rules_kotlin#1).
_RULES_KOTLIN_COMMIT = "de1b3043036e31c97f121b41e2cdf57c16c42a3d"

archive_override(
    module_name = "rules_kotlin",
    integrity = "sha256-qP7byx5muysVK298i+OoQadBhC4N+SZhvLtqTjhq8a4=",
    strip_prefix = "rules_kotlin-%s" % _RULES_KOTLIN_COMMIT,
    urls = ["https://github.com/0xLucasMarcal/rules_kotlin/archive/%s.tar.gz" % _RULES_KOTLIN_COMMIT],
)

# --- JDK 27 -----------------------------------------------------------------------------------

jdk27 = use_extension("//bazel/jdk:extensions.bzl", "jdk27")
use_repo(
    jdk27,
    "remotejdk27_linux",
    "remotejdk27_linux_aarch64",
    "remotejdk27_linux_aarch64_toolchain_config_repo",
    "remotejdk27_linux_toolchain_config_repo",
    "remotejdk27_macos_aarch64",
    "remotejdk27_macos_aarch64_toolchain_config_repo",
    "remotejdk27_win",
    "remotejdk27_win_toolchain_config_repo",
)

register_toolchains(
    "@remotejdk27_linux_toolchain_config_repo//:all",
    "@remotejdk27_linux_aarch64_toolchain_config_repo//:all",
    "@remotejdk27_macos_aarch64_toolchain_config_repo//:all",
    "@remotejdk27_win_toolchain_config_repo//:all",
    "//bazel/jdk:toolchain_jdk_25_definition",
)

