package(default_visibility = ["//visibility:public"])

# OkHttp 5 publishes JVM and Android variants of one API, which Gradle picks per platform. Bazel
# has one classpath, so every target uses the Android variant: the APK needs its Android platform
# integration (PlatformRegistry, androidx.startup initializer), and JVM tests only use OkHttp's
# plain model types. Never add okhttp-jvm next to it: Bazel merges duplicate classes first-wins,
# and the JVM PlatformRegistry crashes the app at startup.
alias(
    name = "okhttp",
    actual = "@maven//:com_squareup_okhttp3_okhttp_android",
)
