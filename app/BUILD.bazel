        "@maven//:androidx_lifecycle_lifecycle_viewmodel_navigation3",
        "@maven//:androidx_navigation3_navigation3_runtime",
        "@maven//:androidx_navigation3_navigation3_ui",
        "@maven//:dev_zacsweers_metro_runtime_jvm",
