        # site itself embeds in its HTML.
        "GHOST_API_URL": "https://jasonpearson.ghost.io/ghost/api/content/",
        "GHOST_CONTENT_API_KEY": "85c0ab53b21839d275cac14df2",
    },
    custom_package = "dev.jasonpearson.android",
    debug_key = "debug.keystore",
    min_sdk = 27,
    plugins = ["metro"],
    proguard_specs = ["proguard-rules.pro"],
    target_sdk = 37,
    # AutoMobile tests drive a device; they're the targets below.
    test_excludes = ["src/test/java/dev/jasonpearson/android/automobiletest/**"],
    version_code = 1,
    version_name = "1.0",
    deps = [
        "//client/ghost",
        "//client/github",
        "//core/di",
        "//core/network",
        "//data/about",
        "//data/articles",
        "//data/bookmarks",
