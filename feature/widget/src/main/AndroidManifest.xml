<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="dev.jasonpearson.android.feature.widget.LatestArticleWidgetReceiver"
            android:exported="true"
            android:label="@string/latest_article_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/latest_article_widget_info" />
        </receiver>
        <receiver
            android:name="dev.jasonpearson.android.feature.widget.PhotoOfTheDayWidgetReceiver"
            android:exported="true"
            android:label="@string/photo_of_the_day_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/photo_of_the_day_widget_info" />
        </receiver>
    </application>
</manifest>
